[
  {
    "ref": "asiguraricraiova_hsts_300",
    "description": "HSTS initial 300 seconds - HTTPS apex and www",
    "enabled": true,
    "expression": "(ssl and http.host in {\"asiguraricraiova.ro\" \"www.asiguraricraiova.ro\"})",
    "action": "rewrite",
    "action_parameters": {
      "headers": {
        "strict-transport-security": {
          "operation": "set",
          "value": "max-age=300"
        }
      }
    }
  },
  {
    "ref": "asiguraricraiova_locuinta_frame_protection",
    "description": "Block framing - locuinta page and extensionless alias",
    "enabled": true,
    "expression": "(ssl and http.host in {\"asiguraricraiova.ro\" \"www.asiguraricraiova.ro\"} and http.request.uri.path in {\"/locuinta.html\" \"/locuinta\"})",
    "action": "rewrite",
    "action_parameters": {
      "headers": {
        "content-security-policy": {
          "operation": "set",
          "value": "frame-ancestors 'none'"
        },
        "x-frame-options": {
          "operation": "set",
          "value": "DENY"
        }
      }
    }
  }
]
